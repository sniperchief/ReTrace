# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers), or a local
# single-node replica set such as mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=retrace

# Random secret of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=<replace-with-random-secret>

# Public URL of the app (used for auth callbacks and trusted origins).
AUTH_URL=http://localhost:3000

# --- AI-assisted entry (optional) -------------------------------------------
# off    : manual entry only (default)
# remote : use the self-hosted inference service below (Whisper + Gemma)
INFERENCE_MODE=off
# URL of the inference service, e.g. https://<user>-<space>.hf.space or http://127.0.0.1:7860
INFERENCE_BASE_URL=
# Same value as the inference service's INFERENCE_API_KEY (32+ random characters).
INFERENCE_API_KEY=
# Per-call timeout in ms (must stay under Vercel Hobby's 300 s function limit).
INFERENCE_TIMEOUT_MS=270000
# Upload limits (Vercel Hobby rejects request bodies over 4.5 MB).
MAX_AUDIO_BYTES=4000000
MAX_AUDIO_SECONDS=180
# Voice notes one technician may send per hour (protects the shared free AI server).
VOICE_NOTES_PER_HOUR=20
