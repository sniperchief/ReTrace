# Copy to .env for local runs. On Hugging Face, set INFERENCE_API_KEY as a Space *secret*.

# Shared with the web app's INFERENCE_API_KEY. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_API_KEY=<replace-with-random-key>

# "small" (default) or "base" (faster, less accurate)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
# WHISPER_DOWNLOAD_ROOT=.models/whisper

# llama.cpp llama-server; Ollama's OpenAI-compatible API also works (http://127.0.0.1:11434)
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=gemma-3-1b-it-q4_k_m
LLM_TIMEOUT_SECONDS=240
LLM_MAX_TOKENS=700

MAX_AUDIO_BYTES=4194304
MAX_AUDIO_SECONDS=180
